# ==============================================================================
# Business Coach CRM — Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials:
#   cp .env.example .env
# NOTE: All VITE_* variables are bundled into the client build.
# NEVER place sensitive database passwords or service-role keys here.
# ==============================================================================

# Supabase Project Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# n8n Automation Webhook
# Triggered when a public lead submits an enquiry via / (LeadCapture)
VITE_N8N_LEAD_WEBHOOK_URL=https://your-n8n-instance.com/webhook/lead-submit

# Cal.com Scheduling URL
# Your public Cal.com event booking link used across the CRM
VITE_CAL_BOOKING_URL=https://cal.com/your-username/business-growth-consultation

# Application Branding
VITE_APP_NAME="Business Coach CRM"
